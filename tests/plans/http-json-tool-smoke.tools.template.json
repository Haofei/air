{
  "tools": {
    "web.search": {
      "kind": "http_json",
      "capability": "network.search",
      "url": "http://127.0.0.1:{{PORT}}/search",
      "method": "POST",
      "timeout_seconds": 5,
      "headers": {
        "x-air-test": "http-json-tool"
      },
      "body": {
        "query": "{{query}}",
        "source": "air-http-json-smoke"
      }
    }
  }
}
