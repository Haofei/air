{
  "tools": {
    "glob": {
      "kind": "repo_files",
      "capability": "code.read",
      "repo_dir": "../..",
      "max_files": 100
    },
    "question": {
      "kind": "local_reflection",
      "capability": "code.read"
    },
    "read": {
      "kind": "file_read",
      "capability": "file.read",
      "base_dir": "../..",
      "max_bytes": 51200
    },
    "grep": {
      "kind": "file_search",
      "capability": "file.read",
      "base_dir": "../..",
      "max_matches": 100,
      "max_context_lines": 2,
      "max_line_chars": 2000,
      "max_bytes": 51200
    },
    "lsp": {
      "kind": "rust_analyzer",
      "capability": "code.read",
      "root_dir": "../..",
      "max_results": 120,
      "max_diagnostics": 80,
      "max_bytes": 51200
    },
    "webfetch": {
      "kind": "web_fetch",
      "capability": "code.read",
      "timeout_seconds": 120,
      "max_bytes": 51200
    },
    "skill": {
      "kind": "local_reflection",
      "capability": "code.read"
    }
  }
}
