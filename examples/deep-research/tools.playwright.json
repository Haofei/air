{
  "tools": {
    "web.search": {
      "kind": "playwright_search",
      "capability": "network.search",
      "script_path": "../../scripts/playwright_search.cjs",
      "query_variants": [
        "{{query}} GitHub",
        "{{query}} documentation",
        "{{query}} issues releases"
      ],
      "max_results": 8,
      "max_results_per_query": 6,
      "max_per_domain": 2,
      "max_content_chars": 12000,
      "exclude_domains": [
        "pinterest.com",
        "facebook.com",
        "x.com",
        "twitter.com"
      ],
      "page_concurrency": 3,
      "navigation_timeout_ms": 12000,
      "overall_timeout_ms": 110000,
      "search_delay_ms": 500,
      "retry_count": 1,
      "fetch_pages": true,
      "timeout_seconds": 120
    },
    "research.think": {
      "kind": "local_reflection",
      "capability": "research.reflect"
    }
  }
}
