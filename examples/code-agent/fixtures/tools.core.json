{
  "tools": {
    "web.search": {
      "kind": "local_docs_search",
      "capability": "network.search",
      "max_results": 4,
      "documents": [
        {
          "id": "docs-command-run-safety",
          "title": "Command runner safety for coding agents",
          "content": "Coding agents should use configured commands, bounded timeouts, structured diagnostics, and parameter policies instead of raw shell access."
        },
        {
          "id": "docs-code-agent-loop",
          "title": "Core coding-agent loop",
          "content": "A capable coding agent should first explore repository context, then choose a narrow edit context, apply constrained file changes, and verify with configured validations."
        },
        {
          "id": "docs-edit-safety",
          "title": "Edit safety",
          "content": "Edit loops should avoid raw shell access, require a prior read before writes, validate patches with dry run, and preserve structured diagnostics for audit."
        }
      ]
    },
    "todo.write": {
      "kind": "todo_write",
      "capability": "task.progress",
      "max_items": 8,
      "max_content_chars": 120
    },
    "todo.read": {
      "kind": "todo_read",
      "capability": "task.progress"
    },
    "repo.files": {
      "kind": "repo_files",
      "capability": "code.read",
      "repo_dir": "../../..",
      "max_files": 100
    },
    "repo.search": {
      "kind": "repo_search",
      "capability": "code.read",
      "repo_dir": "../../..",
      "max_matches": 80,
      "max_bytes": 65536
    },
    "repo.context": {
      "kind": "repo_context",
      "capability": "code.read",
      "repo_dir": "../../..",
      "max_matches": 80,
      "max_files": 8,
      "context_lines": 8,
      "max_bytes": 65536
    },
    "repo.symbols": {
      "kind": "repo_symbols",
      "capability": "code.read",
      "repo_dir": "../../..",
      "max_symbols": 120,
      "max_bytes": 65536
    },
    "repo.references": {
      "kind": "repo_references",
      "capability": "code.read",
      "repo_dir": "../../..",
      "max_matches": 120,
      "max_files": 8,
      "context_lines": 4,
      "max_bytes": 65536
    },
    "lsp.references": {
      "kind": "rust_analyzer_references",
      "capability": "code.read",
      "root_dir": "../../..",
      "command": "rust-analyzer",
      "max_results": 120,
      "max_bytes": 65536
    },
    "lsp.diagnostics": {
      "kind": "rust_analyzer_diagnostics",
      "capability": "code.read",
      "root_dir": "../../..",
      "command": "rust-analyzer",
      "max_diagnostics": 80,
      "max_bytes": 65536
    },
    "file.read": {
      "kind": "file_read",
      "capability": "file.read",
      "base_dir": "../../..",
      "max_bytes": 32768
    },
    "file.read_many": {
      "kind": "file_read_many",
      "capability": "file.read",
      "base_dir": "../../..",
      "max_files": 4,
      "max_bytes": 65536
    },
    "file.search": {
      "kind": "file_search",
      "capability": "file.read",
      "base_dir": "../../..",
      "max_matches": 40,
      "max_context_lines": 2,
      "max_line_chars": 2000,
      "max_bytes": 32768
    },
    "file.edit": {
      "kind": "file_edit",
      "capability": "file.write",
      "base_dir": "../../..",
      "require_read": true,
      "allow_replace_all": false,
      "max_bytes": 65536,
      "max_changed_lines": 80
    },
    "file.ops": {
      "kind": "file_ops",
      "capability": "file.write",
      "base_dir": "../../..",
      "require_read": true,
      "allow_new_files": true,
      "allow_overwrite": false,
      "allow_replace_all": false,
      "max_files": 6,
      "max_bytes": 65536,
      "max_changed_lines": 80
    },
    "diagnostic.context": {
      "kind": "diagnostic_context",
      "capability": "code.read",
      "repo_dir": "../../..",
      "max_diagnostics": 10,
      "context_lines": 4,
      "max_bytes": 65536
    },
    "code.assert": {
      "kind": "code_assert",
      "capability": "code.read",
      "base_dir": "../../..",
      "max_assertions": 12,
      "max_bytes": 65536
    },
    "candidate.validate": {
      "kind": "candidate_validate",
      "capability": "code.read",
      "base_dir": "../../.."
    },
    "git.status": {
      "kind": "git_status",
      "capability": "code.read",
      "repo_dir": "../../..",
      "max_files": 200
    },
    "git.diff": {
      "kind": "git_diff",
      "capability": "code.read",
      "repo_dir": "../../..",
      "max_bytes": 65536
    },
    "test.run": {
      "kind": "command_run",
      "capability": "code.test",
      "cwd": "../../..",
      "commands": {
        "default": [
          "node",
          "examples/code-agent/edit-fixture/test.js"
        ]
      },
      "timeout_seconds": 30,
      "max_bytes": 65536,
      "truncation_direction": "tail"
    },
    "format.run": {
      "kind": "command_run",
      "capability": "code.test",
      "cwd": "../../..",
      "commands": {
        "default": [
          "cargo",
          "fmt",
          "--all"
        ]
      },
      "timeout_seconds": 30,
      "max_bytes": 65536,
      "truncation_direction": "tail"
    }
  },
  "approvals": {
    "file.write": {
      "approved": true,
      "approver": "code-agent-fixture",
      "reason": "bounded code-agent write is allowed after AIR approval gate"
    }
  }
}
