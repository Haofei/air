{
  "tools": {
    "glob": {
      "kind": "repo_files",
      "capability": "code.read",
      "repo_dir": "../../..",
      "max_files": 100
    },
    "read": {
      "kind": "file_read",
      "capability": "file.read",
      "base_dir": "../../..",
      "max_bytes": 32768
    },
    "grep": {
      "kind": "file_search",
      "capability": "file.read",
      "base_dir": "../../..",
      "max_matches": 100,
      "max_context_lines": 2,
      "max_line_chars": 2000,
      "max_bytes": 32768
    },
    "lsp": {
      "kind": "rust_analyzer",
      "capability": "code.read",
      "root_dir": "../../..",
      "command": "rust-analyzer",
      "max_results": 80,
      "max_diagnostics": 80,
      "max_bytes": 32768
    },
    "edit": {
      "kind": "file_edit",
      "capability": "file.write",
      "base_dir": "../../..",
      "max_bytes": 262144
    },
    "bash": {
      "kind": "bash",
      "capability": "code.test",
      "cwd": "../../..",
      "timeout_seconds": 120,
      "max_bytes": 65536,
      "truncation_direction": "tail"
    },
    "todowrite": {
      "kind": "todo_write",
      "capability": "code.read"
    }
  }
}
