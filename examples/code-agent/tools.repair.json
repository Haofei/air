{
  "tools": {
    "todo.write": {
      "kind": "todo_write",
      "capability": "task.progress",
      "max_items": 8,
      "max_content_chars": 120
    },
    "todo.read": {
      "kind": "todo_read",
      "capability": "task.progress"
    },
    "file.read": {
      "kind": "file_read",
      "capability": "file.read",
      "base_dir": "../..",
      "max_bytes": 32768
    },
    "file.read_many": {
      "kind": "file_read_many",
      "capability": "file.read",
      "base_dir": "../..",
      "max_files": 4,
      "max_bytes": 65536
    },
    "file.search": {
      "kind": "file_search",
      "capability": "file.read",
      "base_dir": "../..",
      "max_bytes": 32768,
      "max_matches": 12,
      "max_context_lines": 12
    },
    "file.edit": {
      "kind": "file_edit",
      "capability": "file.write",
      "base_dir": "../..",
      "require_read": true,
      "allow_replace_all": false,
      "max_bytes": 65536
    },
    "file.ops": {
      "kind": "file_ops",
      "capability": "file.write",
      "base_dir": "../..",
      "require_read": true,
      "allow_new_files": true,
      "allow_overwrite": false,
      "allow_replace_all": false,
      "max_files": 6,
      "max_bytes": 65536
    },
    "file.patch": {
      "kind": "file_patch",
      "capability": "file.write",
      "repo_dir": "../..",
      "require_read": true,
      "allow_new_files": false,
      "allow_delete_files": false,
      "max_files": 1,
      "max_bytes": 65536
    },
    "diagnostic.context": {
      "kind": "diagnostic_context",
      "capability": "code.read",
      "repo_dir": "../..",
      "max_diagnostics": 10,
      "context_lines": 4,
      "max_bytes": 65536
    },
    "git.status": {
      "kind": "git_status",
      "capability": "code.read",
      "repo_dir": "../..",
      "max_files": 200
    },
    "git.diff": {
      "kind": "git_diff",
      "capability": "code.read",
      "repo_dir": "../..",
      "max_bytes": 65536
    },
    "test.run": {
      "kind": "command_run",
      "capability": "code.test",
      "cwd": "../..",
      "commands": {
        "repair_fixture_test": [
          "node",
          "examples/code-agent/repair-fixture/test.js"
        ]
      },
      "timeout_seconds": 30,
      "max_bytes": 65536
    }
  },
  "approvals": {
    "file.write": {
      "approved": true,
      "approver": "code-agent-fixture",
      "reason": "bounded repair patch is allowed after read, diagnostics, and dry-run validation"
    }
  }
}
